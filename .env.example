# BARON production configuration template
PAPER_MODE=True
BINGX_KEY=
BINGX_SECRET=
MAX_OPEN_POSITIONS=6
MAX_TECHNICAL_POSITIONS=5
LEVERAGE=10
RISK_ALLOC=0.60

# Trade-management hardening
BREAKEVEN_RATCHET_ROE=2.0
PROFIT_LOCK_MIN_ROE=1.0
MOVE_MATURITY_HARD_GATE=1
QUEUE_MATURITY_HARD_GATE=0
ENABLE_NATIVE_PROTECTION=1
NATIVE_PROTECTION_ORDER_TYPE=STOP_MARKET
NATIVE_PROTECTION_VERIFY=1
REQUIRE_NATIVE_PROTECTION_LIVE=1
NATIVE_PROTECTION_PARAMS_JSON={}
ORDERBOOK_CACHE_TTL_SEC=5
ORDERBOOK_STALE_MAX_SEC=30
TRADE_LIFECYCLE_LOG=runtime/trade_lifecycle.jsonl
SETUP_EDGE_LOG=runtime/setup_outcomes.jsonl

# Telegram close notifications (full close only, after exchange verification)
# Leave empty to disable. Never hard-code secrets in code or commits.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# News intelligence
NEWS_ENABLED=True
NEWS_TIMEOUT_SEC=4
NEWS_CACHE_TTL_SEC=300
NEWS_REACTION_WINDOW_SEC=600
NEWS_RISK_BLOCK=80
NEWS_SLOT_ENABLED=True

# Discovery
GLOBAL_SCAN_INTERVAL_SEC=900
WATCHLIST_SERVICE_INTERVAL_SEC=20
QUEUE_RE_EVAL_INTERVAL=5

# Freqtrade-inspired portfolio protections (risk gates only; opt-in pair cooldown)
PROTECTION_STOPLOSS_LIMIT=3
PROTECTION_WINDOW_SEC=3600
PROTECTION_COOLDOWN_SEC=0
ENABLE_PAIR_COOLDOWN_LEDGER=0

# Persistent materialized trade state (survives restart)
TRADE_STATE_PATH=runtime/trade_state.json

# OpenBB-inspired data fabric is evidence-only; no execution authority
DATA_FABRIC_ENABLED=1

# Institutional pre-STRONG preparation: begin Institutional Radar before the
# public STRONG watchlist tier (raw STRONG remains 8.0).
PRE_STRONG_SCORE=6.0
